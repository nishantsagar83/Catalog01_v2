{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smtcatalog",
  "compatibility_date": "2026-07-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}

{
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "catalog-images"
    }
  ]
}
